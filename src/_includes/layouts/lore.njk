<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  {% if hidden %}<meta name="robots" content="noindex">{% endif %}

  <link rel="stylesheet" href="/style/style.css">
  <link rel="stylesheet" href="/style/root.css">
  <script src="/style/hover.js"></script>
  <title>RETROGRADE - {{ title | upper }}</title>
</head>

<body>
  <div id="header-placeholder"></div>
  <script src="/header.js"></script>

  <div class="lore-container">
    <div class="lore-header">
      <h1 class="lore-title">{{ title }}</h1>
      {% if subtitle %}<p class="intro-subtitle">{{ subtitle }}</p>{% endif %}
      {% if updated %}<p class="lore-updated">Last updated: {{ updated }}</p>{% endif %}
    </div>

    {% if toc %}
    <div class="lore-toc">
      <div class="lore-toc-header" onclick="toggleLoreTOC()">
        <span class="lore-toc-title">Contents</span>
        <span class="lore-toc-toggle" id="lore-toc-toggle">[hide]</span>
      </div>
      <ol class="lore-toc-list" id="lore-toc-list"></ol>
    </div>
    {% endif %}

    <div class="lore-section{% if collapse %} zone-body{% endif %}">
      {{ content | safe }}
    </div>
  </div>
{% if toc %}
  <script>
    var list = document.getElementById('lore-toc-list');
    var used = {};
    document.querySelectorAll('.lore-section h2').forEach(function (h) {
      var id = h.id || h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      if (used[id]) { used[id]++; id = id + '-' + used[id]; } else { used[id] = 1; }
      h.id = id;
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + id;
      a.textContent = h.textContent;
      li.appendChild(a);
      list.appendChild(li);
    });

    function toggleLoreTOC() {
      var toggle = document.getElementById('lore-toc-toggle');
      var hidden = list.style.display === 'none';
      list.style.display = hidden ? 'block' : 'none';
      toggle.textContent = hidden ? '[hide]' : '[show]';
    }
  </script>
  {% endif %}
  {% if collapse %}<script src="/style/zone.js"></script>{% endif %}
</body>
</html>
