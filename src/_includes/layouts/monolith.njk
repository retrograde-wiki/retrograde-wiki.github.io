---
layout: layouts/base.njk
extraCss: /css/lore.css
---
<article class="lore-article">
  {% if image %}
  <img src="{{ image }}" alt="{{ title }} logo" class="monolith-logo">
  {% endif %}

  {% set basicIcons = {
    "ZONE": "fa-map-pin",
    "INDUSTRY": "fa-industry",
    "LEADERSHIP": "fa-user-tie",
    "HEADQUARTERS": "fa-building"
  } %}
  <div class="zone-stat-strip">
    {% for stat in basics %}
    <div class="zone-stat">
      <span class="zone-stat-label">
        {% if basicIcons[stat.label] %}<i class="fa-solid {{ basicIcons[stat.label] }}"></i> {% endif %}{{ stat.label }}
      </span>
      <span class="zone-stat-value">{{ stat.value }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="prose">
    {% if employees %}
    <h2>Notable Employees</h2>
    <ul>
      {% for emp in employees %}
      <li><a href="{{ emp.page }}">{{ emp.name }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if spotifyTrack %}
    <h2>Ambience</h2>
    <iframe style="border-radius:8px" src="{{ spotifyTrack }}" width="100%" height="152" frameborder="0" allow="encrypted-media"></iframe>
    {% endif %}

    {{ content | safe }}
  </div>

  {% if gallery %}
  <div class="zone-gallery">
    {% for shot in gallery %}
    <a href="{{ shot.href or shot.src }}" target="_blank" rel="noopener" class="zone-gallery-item">
      <img src="{{ shot.src }}" alt="{{ shot.alt or '' }}">
    </a>
    {% endfor %}
  </div>
  {% endif %}
</article>
